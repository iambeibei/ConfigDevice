<Window
    x:Class="LightGateway.View.WriteResultDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Title}"
    Width="520"
    MinHeight="200"
    MaxHeight="640"
    Background="White"
    FontFamily="Microsoft YaHei UI"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="ConfirmButton" TargetType="Button">
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Grid Width="30" Height="30" VerticalAlignment="Center">
                    <Ellipse Fill="{Binding AccentBrush}" />
                    <Path
                        Data="M8.5 15.5 L13 20 L21.5 10"
                        Stroke="White"
                        StrokeThickness="2.4"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}" />
                    <Path
                        Data="M15 8 L15 17.5"
                        Stroke="White"
                        StrokeThickness="2.4"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        Visibility="{Binding IsWarning, Converter={StaticResource BoolToVis}}" />
                    <Ellipse
                        Width="2.6"
                        Height="2.6"
                        Margin="0,21,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Fill="White"
                        Visibility="{Binding IsWarning, Converter={StaticResource BoolToVis}}" />
                    <Path
                        Data="M11 11 L19 19 M19 11 L11 19"
                        Stroke="White"
                        StrokeThickness="2.4"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <TextBlock
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{Binding AccentTextBrush}"
                    Text="{Binding Title}" />
            </StackPanel>

            <TextBlock
                Margin="0,14,0,0"
                FontSize="14"
                Foreground="#172033"
                Text="{Binding Summary}"
                TextWrapping="Wrap" />

            <Border
                Margin="0,14,0,0"
                Padding="12"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        FontSize="13"
                        Foreground="#475569"
                        Text="{Binding Detail}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Background="{Binding AccentBrush}"
                Click="ConfirmButton_Click"
                Content="{Binding ConfirmText}"
                IsDefault="True"
                Style="{StaticResource ConfirmButton}" />
        </StackPanel>
    </Grid>
</Window>
